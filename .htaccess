# ==============================================================
# CODELIX Official cPanel & Apache Web Server Configuration
# Clean root domain (https://codelix.online/) — No /dist/ in URL!
# ==============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Clean redirect from cached /dist/ to root domain
  RewriteCond %{THE_REQUEST} \s/dist/ [NC]
  RewriteRule ^dist/(.*)$ /$1 [R=301,L]

  # 2. Route assets to dist/assets if they are located in dist
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 3. Serve dist/index.html internally for root URL / (No redirect, URL stays codelix.online)
  RewriteRule ^$ dist/index.html [L]

  # 4. Standard SPA fallback for any deep routes or direct links
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# Ensure proper MIME types for modern ECMAScript modules, CSS, and fonts
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
</IfModule>

# Security and cache headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Access-Control-Allow-Origin "*"
</IfModule>

# Enable GZIP compression for fast mobile loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
